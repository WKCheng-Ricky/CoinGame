{
  "name": "coin-game",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "start": "node e2e/serve.js",
    "test": "node --test",
    "test:coverage": "c8 --all --check-coverage --lines 80 --branches 80 --functions 80 --per-file --include 'src/**' --exclude 'src/main.js' --reporter=text --reporter=lcov --reports-dir=coverage/unit node --test",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "COVERAGE_ENFORCE=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "c8": "^12.0.0",
    "jsdom": "^30.1.3",
    "monocart-coverage-reports": "^2.13.2"
  }
}
